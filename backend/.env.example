# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real keys. Both keys are optional: the service degrades
# honestly without them (Wikipedia-only evidence, verdicts capped at
# UNVERIFIED). See README.md's "Keys" section for where to get them.

TRUTHGUARD_GEMINI_API_KEY=
TRUTHGUARD_FACTCHECK_API_KEY=

# Everything below has a sensible default (see app/config.py) — override
# only if you actually need to.

# TRUTHGUARD_GEMINI_MODEL=gemini-flash-latest
# TRUTHGUARD_CACHE_TTL_SECONDS=604800
# TRUTHGUARD_RATE_LIMIT_PER_HOUR=30
# TRUTHGUARD_MAX_CLAIMS_PER_REQUEST=3
# TRUTHGUARD_PROVIDER_TIMEOUT_SECONDS=8.0
# TRUTHGUARD_GEMINI_TIMEOUT_SECONDS=30.0
